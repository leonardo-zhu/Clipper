{
  "name": "clipper",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "analyze": "node scripts/analyze.js",
    "check:i18n": "node scripts/check-i18n.js",
    "check:state-flow": "node scripts/check-state-flow.js",
    "check:all": "pnpm typecheck && pnpm check:i18n && pnpm check:state-flow",
    "preios": "pnpm check:all",
    "preandroid": "pnpm check:all",
    "prestart": "pnpm check:all",
    "migrate:snapshot": "node scripts/migrate-snapshot.js"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/noto-sans-sc": "^0.4.3",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "~55.0.10",
    "@expo/vector-icons": "^15.1.1",
    "@op-engineering/op-sqlite": "^15.2.12",
    "@react-navigation/drawer": "^7.9.4",
    "expo": "~55.0.18",
    "expo-constants": "~55.0.15",
    "expo-document-picker": "^55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-font": "^55.0.6",
    "expo-linking": "~55.0.14",
    "expo-localization": "^55.0.13",
    "expo-router": "~55.0.13",
    "expo-share-intent": "^6.1.0",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~55.0.5",
    "openai": "^6.35.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-webview": "~13.16.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "typescript": "~5.8.3"
  },
  "private": true
}
